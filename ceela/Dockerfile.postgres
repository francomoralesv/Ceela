FROM postgres:15-alpine

# Copiar el script de inicialización personalizado
COPY init-db.sh /docker-entrypoint-initdb.d/01-init-db.sh

# Copiar el archivo backup.sql
COPY backup.sql /docker-entrypoint-initdb.d/02-backup.sql

# Dar permisos de ejecución al script
RUN chmod +x /docker-entrypoint-initdb.d/01-init-db.sh

# Los archivos en /docker-entrypoint-initdb.d/ se ejecutan automáticamente
# en orden alfabético cuando se inicializa la base de datos por primera vez